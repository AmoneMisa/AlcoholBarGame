{
  "name": "barlingo-telegram-miniapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch --import ./tests/register.mjs server/index.mjs",
    "dev:server:memory": "node --watch --import ./tests/register.mjs server/dev-memory.mjs",
    "build": "vue-tsc --noEmit && vite build && vite build --ssr server/index.mjs --outDir dist-server --emptyOutDir",
    "preview": "vite preview",
    "start": "node dist-server/index.js",
    "test": "node --import ./tests/register.mjs --test tests/game.test.mjs tests/economy.test.mjs tests/trade.test.mjs tests/server.test.mjs tests/avatar.test.mjs tests/social.test.mjs tests/situations.test.mjs tests/delivery.test.mjs",
    "db:export-cocktails": "node --import ./tests/register.mjs scripts/export-cocktails.mjs",
    "docker:clean": "powershell -ExecutionPolicy Bypass -File scripts/docker-clean.ps1"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "latest",
    "dictionary-en": "^4.0.0",
    "express": "^5.2.1",
    "nspell": "^2.1.5",
    "pg": "^8.23.0",
    "pinia": "latest",
    "three": "0.180.0",
    "vite": "latest",
    "vue": "latest"
  },
  "devDependencies": {
    "@types/nspell": "^2.1.6",
    "@types/three": "0.180.0",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.11"
  }
}
