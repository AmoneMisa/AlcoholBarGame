# Copy to .env in the deploy directory on the server (default /opt/barlingo) and fill in. Never commit the real file.

# Your domain (an A record pointing to this server). Caddy gets the HTTPS certificate for it.
DOMAIN=bar.example.com

# Database password: a long random string, e.g. from:  openssl rand -hex 24
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=barlingo
POSTGRES_USER=barlingo

# The full token from @BotFather (123456789:AA…).
TELEGRAM_BOT_TOKEN=replace-with-the-full-botfather-token

# First start only; after that the CI deploy passes the exact image of each commit.
APP_IMAGE=ghcr.io/amonemisa/alcoholbargame:latest
