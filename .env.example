POSTGRES_DB=barlingo
POSTGRES_USER=barlingo
POSTGRES_PASSWORD=replace-with-a-long-random-password
APP_PORT=3000
# For a published GitHub Container Registry image:
# APP_IMAGE=ghcr.io/amonemisa/alcoholbargame:latest


# Telegram bot token (from @BotFather). The server uses it to verify that players really come from Telegram.
TELEGRAM_BOT_TOKEN=replace-with-your-bot-token
# Local development only: allow playing in a normal browser without Telegram. Never enable in production.
# ALLOW_DEV_LOGIN=true
