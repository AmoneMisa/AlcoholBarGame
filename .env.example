POSTGRES_DB=barlingo
POSTGRES_USER=barlingo
POSTGRES_PASSWORD=replace-with-a-long-random-password
APP_PORT=3000
# For a published GitHub Container Registry image:
# APP_IMAGE=ghcr.io/amonemisa/alcoholbargame:latest


# The only Telegram environment value. Paste the FULL token from @BotFather, for example
# 123456789:AAExampleToken — the numeric bot ID alone is not an authentication credential.
# The server verifies Mini App players, connects the bot, installs /start, /game and /help,
# and answers those commands. Configure this bot's Main Mini App URL once in @BotFather.
TELEGRAM_BOT_TOKEN=123456789:replace-with-the-full-botfather-token
# Local development only: allow playing in a normal browser without Telegram. Never enable in production.
# ALLOW_DEV_LOGIN=true
